{
  "name": "linkage-studio",
  "private": true,
  "version": "0.16.0-rebuild.4",
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "test:tooling": "node --test tests/rebuild-portability.test.mjs tests/toolchain-compat.test.mjs",
    "test:browser:prepare": "node scripts/rebuild/prepare-browser.mjs --install-tooling --install-browsers",
    "test:browser": "node scripts/rebuild/run-g9.mjs --cumulative --through-g10",
    "test:production": "node scripts/rebuild/verify-g10-production.mjs chromium",
    "typecheck": "tsc -b",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azure/msal-browser": "5.29.1",
    "lucide-react": "1.73.0",
    "nanoid": "5.1.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.6"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.8",
    "globals": "^17.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
